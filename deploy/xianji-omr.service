[Unit]
Description=Xianji OMR image annotation API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=xianji-omr
Group=xianji-omr
WorkingDirectory=/opt/xianji-omr/current
Environment=OMR_CONFIG=/etc/xianji-omr/config.json
Environment=NODE_ENV=production
ExecStart=/opt/xianji-omr/runtime/node/bin/node /opt/xianji-omr/current/server/src/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# OSS SDK reads local network interfaces through netlink on Linux.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
MemoryMax=512M
TasksMax=64
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
