{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "xianji-omr permanent deletion preview input",
  "type": "object",
  "required": [
    "kind",
    "ids"
  ],
  "properties": {
    "kind": {
      "enum": [
        "dataset",
        "song",
        "page",
        "region",
        "locDataset",
        "locRecord",
        "locMeasure",
        "locEvent",
        "snapshot",
        "locSnapshot"
      ]
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "regionIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "region",
              "locMeasure",
              "locEvent"
            ]
          }
        }
      },
      "then": {
        "required": [
          "regionIds"
        ],
        "properties": {
          "ids": {
            "maxItems": 1
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "regionIds"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
