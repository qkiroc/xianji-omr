{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xianji-omr:localization-import:v1",
  "title": "Localization import v1",
  "type": "object",
  "required": [
    "corpus",
    "sourcePageMap"
  ],
  "properties": {
    "corpus": {
      "type": "object",
      "required": [
        "version",
        "revision",
        "source",
        "split",
        "measures"
      ],
      "properties": {
        "version": {
          "const": "omr-event-corpus-v1"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "object",
          "required": [
            "sample_id",
            "group_id",
            "pages"
          ],
          "properties": {
            "sample_id": {
              "type": "string"
            },
            "group_id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "pages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": [
                  "asset_id",
                  "width",
                  "height",
                  "sha256"
                ],
                "properties": {
                  "asset_id": {
                    "type": "string"
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "pixel_sha256": {
                    "type": "string"
                  },
                  "coordinate_mapping": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ]
        },
        "measures": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "page_id",
              "track"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "page_id": {
                "type": "string"
              },
              "track": {
                "enum": [
                  "guitar",
                  "melody"
                ]
              },
              "voice": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "bar_number": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "system_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bbox_xyxy": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              },
              "staff_lines": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 6,
                    "maxItems": 6
                  }
                ]
              },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "voice": {
                      "type": [
                        "string",
                        "number"
                      ]
                    },
                    "center_x": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "bbox_xyxy": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ]
                    },
                    "context_bbox_xyxy": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ]
                    },
                    "review_status": {
                      "enum": [
                        "candidate",
                        "accepted",
                        "rejected"
                      ]
                    },
                    "confidence": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "evidence": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "annotation_source": {
                      "type": [
                        "object",
                        "null"
                      ]
                    },
                    "label": {}
                  },
                  "additionalProperties": true
                },
                "maxItems": 5000
              }
            },
            "additionalProperties": true
          }
        },
        "relations": {},
        "texts": {}
      },
      "additionalProperties": true
    },
    "sourcePageMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "uuid"
      }
    },
    "pixelEquivalence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "acknowledged",
          "platformSha256",
          "historicalSha256",
          "rgbSha256"
        ],
        "properties": {
          "mode": {
            "const": "decoded-rgb-v1"
          },
          "acknowledged": {
            "const": true
          },
          "platformSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "historicalSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rgbSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "geometry": {
      "$ref": "#/$defs/geometry"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "geometry": {
      "type": "object",
      "required": [
        "schemaVersion",
        "pages",
        "measures"
      ],
      "properties": {
        "schemaVersion": {
          "const": "omr-localization-v1"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "localPageId",
              "sourcePageId",
              "sourceSha",
              "pixelSha",
              "width",
              "height",
              "mapping"
            ],
            "properties": {
              "localPageId": {
                "type": "string"
              },
              "sourcePageId": {
                "type": "string",
                "format": "uuid"
              },
              "sourceSha": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pixelSha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "width": {
                "type": "integer",
                "minimum": 1
              },
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "mapping": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "historicalSha": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pixelEquivalence": {
                "type": "object",
                "required": [
                  "mode",
                  "rgbSha256",
                  "platformSha256",
                  "historicalSha256"
                ],
                "properties": {
                  "mode": {
                    "const": "decoded-rgb-v1"
                  },
                  "rgbSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "platformSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "historicalSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "measures": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "pageId",
              "systemId",
              "barNumber",
              "track",
              "voice",
              "bbox",
              "staffLines",
              "events",
              "geometryConfirmed",
              "completenessConfirmed",
              "reviewNote"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "pageId": {
                "type": "string"
              },
              "systemId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "barNumber": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "track": {
                "enum": [
                  "guitar",
                  "melody"
                ]
              },
              "voice": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "bbox": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "minItems": 4,
                    "maxItems": 4
                  }
                ]
              },
              "staffLines": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 6,
                    "maxItems": 6
                  }
                ]
              },
              "events": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "voice",
                    "centerX",
                    "bbox",
                    "contextBBox",
                    "status",
                    "evidence",
                    "annotationSource",
                    "confidence"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "voice": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "centerX": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "bbox": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ]
                    },
                    "contextBBox": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "minItems": 4,
                          "maxItems": 4
                        }
                      ]
                    },
                    "status": {
                      "enum": [
                        "candidate",
                        "accepted",
                        "rejected"
                      ]
                    },
                    "evidence": {
                      "type": "object"
                    },
                    "annotationSource": {
                      "type": "object"
                    },
                    "confidence": {
                      "type": [
                        "number",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              },
              "geometryConfirmed": {
                "type": "boolean"
              },
              "completenessConfirmed": {
                "type": "boolean"
              },
              "reviewNote": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
